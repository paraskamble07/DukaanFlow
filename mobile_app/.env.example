# ShopZen — Flutter Mobile App Environment Configuration
# Copy this file to .env (or configure via --dart-define) NEVER commit the real .env.

# Backend API base URL.
#   Android emulator talking to laptop backend:  http://10.0.2.2:8000
#   Real phone on same Wi-Fi as laptop backend:   http://<YOUR-LAPTOP-LAN-IP>:8000
#   Production (Render):                          https://dukaanflow.onrender.com
API_BASE_URL=https://dukaanflow.onrender.com

# dev | staging | production
ENVIRONMENT=production

# Visible application name
APP_NAME=ShopZen
